# ==============================================================================
# Environment Configuration Template - Manufacturing Manual Assistant
# Copy this file to .env and adjust variables as necessary for your environment.
# ==============================================================================

# Django Core Settings
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Relational Database Settings (PostgreSQL or SQLite for development)
# Set USE_SQLITE=True to force SQLite, or provide DATABASE_URL for PostgreSQL
USE_SQLITE=auto
DATABASE_URL=
DB_NAME=manufacturing_manual_assistant
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=

# Distributed Task Queue & Caching (Celery + Redis)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Frontend & CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Embedding Provider Configuration ('huggingface' or 'lm_studio')
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_API_KEY=your_hugging_face_token_here
EMBEDDING_BASE_URL=

# LM Studio Local Provider (alternative local development)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF

# ChromaDB Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=manufacturing_manual_chunks_v1

# Vector Backend: 'chroma' (default) or 'pgvector' (switch after full migration)
VECTOR_BACKEND=pgvector

# Document Chunking Parameters
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=40

# RAG Semantic Retrieval Parameters
RAG_TOP_K=5

# LLM Answer Generation Configuration ('gemini', 'openai_compatible', 'lm_studio')
# Initial and default provider: Google Gemini API
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1

# Secondary / Self-Hosted LLM Provider (optional, never used as implicit fallback)
LLM_BASE_URL=
LLM_API_KEY=


# ==============================================================================
# Demo Account Provisioning (Development & Demo Seeding Only)
# ==============================================================================
DEMO_ADMIN_EMAIL=sarah.connor@gmail.com
DEMO_ADMIN_PASSWORD=your_demo_admin_password_here
DEMO_ENGINEER_EMAIL=alex.vance@gmail.com
DEMO_ENGINEER_PASSWORD=your_demo_engineer_password_here
DEMO_SUPERVISOR_EMAIL=marcus.brody@gmail.com
DEMO_SUPERVISOR_PASSWORD=your_demo_supervisor_password_here
